{
  "name": "fmea-studio",
  "version": "4.4.0",
  "description": "DFMEA / PFMEA / KC / Kontrol Planı / İzlenebilirlik masaüstü uygulaması",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilsst/fmea.git"
  },
  "author": "hilsst",
  "license": "UNLICENSED",
  "homepage": "https://github.com/hilsst/fmea#readme",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@kenjiuno/msgreader": "1.28.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xmldom/xmldom": "^0.9.8",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dxf-parser": "1.1.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.24.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "playwright-core": "^1.64.1",
    "postal-mime": "4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.7",
    "unpdf": "1.8.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "productName": "FMEA Studio",
  "private": true,
  "build": {
    "appId": "com.hilsst.fmeastudio",
    "productName": "FMEA Studio",
    "copyright": "hilsst",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "fmea",
        "name": "FMEA Projesi",
        "description": "FMEA Studio projesi"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FMEA Studio",
      "language": "1055",
      "artifactName": "FMEA-Studio-Kurulum-${version}.${ext}",
      "differentialPackage": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "desktop": {
        "entry": {
          "StartupWMClass": "FMEA Studio"
        }
      }
    },
    "portable": {
      "artifactName": "FMEA-Studio-Tasinabilir-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hilsst",
        "repo": "fmea",
        "releaseType": "release"
      }
    ]
  }
}
